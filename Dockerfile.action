# syntax=docker/dockerfile:1
#
# Image for the `no_human review gate` GitHub Action (action.yml).
#
# For a `using: docker` action, the runner builds this image with the
# DIRECTORY CONTAINING action.yml as the build context — verified against a
# real Actions run, where a `Dockerfile` living in a subdirectory (with
# `action.yml` pointing at it by relative path, and only the Dockerfile
# itself in that subdirectory) built against an empty context ("transferring
# context: 2B done") and every `COPY src/ ...` failed "not found". Since
# `action.yml` lives at the repository root, this file must too — putting it
# anywhere else makes its own build context a subdirectory that does not
# contain `src/`, `pyproject.toml`, etc. That is why this file lives at the
# repo root even though the product's own `Dockerfile` and `Dockerfile.mcp`
# also do — the build context requirement, not convention, puts it here.
#
# NO CREDENTIAL IS BAKED IN. `credential` arrives only at `docker run` time as
# an environment variable the Action's entrypoint script sets
# (`no_human.ci_action.run`); nothing in this file references
# ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN by value.

FROM python:3.12-slim

# git: the gate diffs and tamper-checks the checked-out workspace directly,
# never through the GitHub API. ca-certificates: TLS to api.github.com and
# the model backend. curl+gnupg: fetch and verify NodeSource's signing key
# below.
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates curl gnupg \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22.x, for the `claude` CLI the reviewer's backend shells out to.
# @anthropic-ai/claude-code declares `"engines": {"node": ">=22.0.0"}` in its
# own package.json — verified by extracting it from this image when this was
# still pinned to Node 20.x, where `npm install` silently accepted the
# mismatch (a bare EBADENGINE warning, not a failure) rather than refusing
# it. Node 20 could work today and stop working on any future CLI release
# that starts relying on a Node-22-only runtime feature, with no signal from
# this Dockerfile that anything changed. Matches Dockerfile's own `node:22-
# slim` stage for the same reason: one supported Node line across the repo.
# Uses NodeSource's documented apt-keyring flow (a signed, pinned repo entry)
# instead of piping its setup script into `bash`, so the install doesn't run
# an arbitrary remote script as root.
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
        | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" \
        > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && npm install -g @anthropic-ai/claude-code@2.1.270 \
    && npm cache clean --force

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

WORKDIR /app
# hatch_build.py is BUILD CONFIGURATION (a custom hatchling hook resolved
# before dependencies) — see Dockerfile / Dockerfile.mcp for the same note.
COPY pyproject.toml uv.lock README.md hatch_build.py ./
COPY src/ ./src/
COPY migrations/ ./migrations/

RUN uv sync --frozen --no-dev

# Create the unprivileged user the CLI subprocess will run as (see the
# entrypoint script below for why), but do NOT `USER nhaction` here. GitHub
# requires `using: docker` actions to start as root — verified against a real
# Actions run, a container with a non-root `USER` directive cannot read
# `/github/workspace` (owned by the RUNNER's UID, unknown at build time) nor
# write the runner-owned `GITHUB_OUTPUT`/`GITHUB_STEP_SUMMARY` files handed in
# at `docker run` time. Two concrete failures reproduced on the runner's exact
# shape: `git config --global` erroring out (exit 255, HOME not writable by
# UID 1000) and a `PermissionError` writing `GITHUB_OUTPUT` (misreported by a
# naive wrapper as "exit 1 blocking findings" instead of the true
# infrastructure failure it is). So this image stays root by default and the
# entrypoint below does root-level setup, then drops privilege itself — see
# that script for the other half of this story (the `claude` CLI's own
# root-refusal, which is why UID 1000 still has to exist and still has to be
# who actually runs the review).
RUN useradd --create-home --uid 1000 --shell /bin/sh nhaction \
    && chown -R nhaction:nhaction /app

# The runner mounts the checked-out PR workspace at a path this image does not
# control (`/github/workspace`, owned by the RUNNER's UID), and `uv run`'s
# project resolution is otherwise relative to the CURRENT DIRECTORY — a plain
# `ENTRYPOINT ["uv", "run", ...]` would resolve against `/github/workspace`
# instead of `/app`, and fail to find no_human's own project entirely.
# `--project /app` below makes that resolution cwd-independent, whatever
# directory the runner sets as the job's workdir.
#
# Entrypoint runs as root (the container's default user, per above) and does
# three things before dropping privilege:
#   1. Take ownership of HOME (`/github/home` for Docker actions, per GitHub's
#      own env contract — never assume `/home/nhaction`) so `git config
#      --global` and the `claude` CLI's own config/cache writes succeed as
#      UID 1000. `mkdir -p` first: on a fresh runner, `/github/home` may not
#      exist yet at all.
#   2. Take ownership of GITHUB_OUTPUT and GITHUB_STEP_SUMMARY themselves
#      (files, not directories, and each may be absent — e.g. GITHUB_OUTPUT is
#      unset entirely in `dry_run` local testing) so `no_human.ci_action.run`
#      can append to them as UID 1000 instead of root.
#   3. Mark the workspace as `safe.directory`, since git separately refuses to
#      operate on a repository it does not consider "owned" by the current
#      UID ("detected dubious ownership"). This has to live here, not in
#      `no_human.ci_action.run`, which only ever runs `git` subcommands
#      read-only diffing/inspecting a checkout (see `_ALLOWED_GIT_SUBCOMMANDS`
#      in run.py) and must not grow a second subprocess call site to fix a
#      container-setup concern. Scoped to `$GITHUB_WORKSPACE` specifically
#      (the runner always sets it for a `pull_request` trigger, per GitHub's
#      own env contract) rather than the wildcard `safe.directory '*'`, which
#      would tell git to trust dubious ownership on ANY path this process
#      ever looks at — unnecessary here since `_ALLOWED_GIT_SUBCOMMANDS`
#      already restricts every `git` call this Action makes to that one
#      checkout. Falls back to `*` only if `GITHUB_WORKSPACE` is somehow
#      unset, so a local/manual `docker run` without it still works.
#
# Then it drops to UID 1000 via `setpriv` (present in the `python:3.12-slim`
# base already — no extra package, no extra image layer — and unlike `su`,
# does not reset the environment, which matters: GITHUB_*/INPUT_*/the
# just-masked credential all have to survive the switch) for the actual
# review run. This is load-bearing, not defense-in-depth: verified against a
# real `docker run`, the `claude` CLI the reviewer shells out to hard-refuses
# its own permission-skip flag with "--dangerously-skip-permissions cannot be
# used with root/sudo privileges for security reasons" when the process is
# UID 0 — which root-by-default would otherwise make every job on this image.
RUN printf '%s\n' \
        '#!/bin/sh' \
        'set -eu' \
        'HOME_DIR="${HOME:-/github/home}"' \
        'export HOME="$HOME_DIR"' \
        'mkdir -p "$HOME_DIR"' \
        'git config --global --add safe.directory "${GITHUB_WORKSPACE:-*}"' \
        'chown -R nhaction:nhaction "$HOME_DIR"' \
        'for f in "${GITHUB_OUTPUT:-}" "${GITHUB_STEP_SUMMARY:-}"; do' \
        '    if [ -n "${f:-}" ] && [ -f "$f" ]; then chown nhaction:nhaction "$f"; fi' \
        'done' \
        'exec setpriv --reuid=nhaction --regid=nhaction --init-groups uv run --no-sync --project /app python -m no_human.ci_action.run "$@"' \
        > /entrypoint.sh \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
