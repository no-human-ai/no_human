#!/bin/sh
# no_human pre-commit gate -- two checks, each owning one thing:
#   * a commit that changes a manifest-pinned file without re-pinning it
#     (scripts/precommit_manifest_gate.py), and
#   * a commit that adds YOUR identity to a branch someone else authored
#     (scripts/precommit_foreign_branch_gate.py), which silently costs a
#     no_human task its next attempt.
# Committed to the repo and OPT-IN: nothing runs until you install it
# (see scripts/hooks/install.sh).
#
# Delegates to scripts/precommit_manifest_gate.py, which is standard-library +
# git only, so no project venv is required. Prefers the repo's .venv python for
# speed if present, then a system python3/python. If none is found the commit is
# allowed rather than blocked -- a missing interpreter must not wedge the repo.
#
# Git runs pre-commit hooks with cwd at the top of the working tree.

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0
gate="$root/scripts/precommit_manifest_gate.py"
foreign_gate="$root/scripts/precommit_foreign_branch_gate.py"
[ -f "$gate" ] || [ -f "$foreign_gate" ] || exit 0

if [ -x "$root/.venv/bin/python" ]; then
    py="$root/.venv/bin/python"
elif command -v python3 >/dev/null 2>&1; then
    py=python3
elif command -v python >/dev/null 2>&1; then
    py=python
else
    echo "no_human pre-commit gate: no python found; skipping (commit allowed)." >&2
    exit 0
fi

# Two gates, each owning one thing. The manifest gate blocks a split commit;
# the foreign-branch gate blocks silently taking over someone else's branch.
# Run both so a commit that trips either is refused, and report whichever
# spoke -- `exec`ing the first would hide the second entirely.
[ -f "$gate" ] && { "$py" "$gate" || exit $?; }
[ -f "$foreign_gate" ] && { "$py" "$foreign_gate" || exit $?; }
exit 0
